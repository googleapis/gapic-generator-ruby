{
  "extends": [
    "config:best-practices",
    ":disableDependencyDashboard"
  ],
  "rangeStrategy": "widen",
  "schedule": ["before 8am"],
  "timezone": "America/Los_Angeles",
  "packageRules": [
    {
      "description": "Golden outputs are generated by `toys gen`; do not update them directly",
      "matchFileNames": ["shared/output/**"],
      "enabled": false
    },
    {
      "description": "Do not update the Bazel example",
      "matchFileNames": ["bazel_example/**"],
      "enabled": false
    }
  ]
}
